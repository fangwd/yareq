{
  "name": "yareq",
  "version": "3.1.0",
  "keywords": [
    "request",
    "proxy",
    "socks",
    "https",
    "authorisation",
    "basic"
  ],
  "description": "Yet another request for Node.js",
  "author": "Weidong Fang",
  "license": "MIT",
  "homepage": "https://github.com/fangwd/yareq",
  "main": "./dist/index.js",
  "files": [
    "src",
    "dist",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fangwd/yareq.git"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/tough-cookie": "^4.0.5",
    "jest": "^30.4.2",
    "tough-cookie": "^6.0.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc -d",
    "test": "jest"
  },
  "jest": {
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testMatch": [
      "**/test/**/*.test.ts"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "watchman": false,
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "collectCoverage": false,
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "verbose": true
  },
  "bugs": {
    "url": "https://github.com/fangwd/yareq/issues"
  },
  "dependencies": {
    "socks-proxy-agent": "^8.0.5"
  }
}
