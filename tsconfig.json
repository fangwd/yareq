{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "types": [
      "node",
      "jest"
    ],
    "typeRoots": [
      "node_modules/@types"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "lib": [
      "es6"
    ],
    "declaration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
